# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=cle_service_role_supabase

# Secret de signature des cookies de session (32+ caractères aléatoires)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=remplace_par_une_valeur_aleatoire

# Analyse IA (facultatif) — sans cette clé, le bouton d'analyse affiche
# simplement que la fonctionnalité n'est pas configurée.
# À créer sur console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
